# Copy this file to .env and fill in real values.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that are auto-promoted to ADMIN the first time they sign in.
ADMIN_EMAILS=""

# Set to "true" to allow the no-password "demo account" sign-in in a
# PRODUCTION build (it's always on outside production). Only for testing a
# deployment before Google OAuth is wired up — unset before going live.
ALLOW_DEMO_LOGIN=""
